{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backup Sync",
  "mainBinaryName": "BackupSync",
  "version": "0.5.3",
  "identifier": "com.valentin.backup-sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Backup Sync",
        "width": 1150,
        "height": 750,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://cdn2.steamgriddb.com https://*.steamstatic.com https://steamcdn-a.akamaihd.net https://upload.wikimedia.org",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "category": "Utility",
    "publisher": "ValentinSK0",
    "homepage": "https://github.com/ValentinSK0/backup-sync",
    "shortDescription": "Backup priečinkov a uložených pozícií hier",
    "longDescription": "Backup Sync bezpečne zálohuje priečinky a uložené pozície hier na Google Drive alebo vlastný cloud.",
    "copyright": "Copyright © 2026 Valentin",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNDBDOUE3N0E1OEE4NUUKUldSZXFGaDZwOGxBYk5IWlkrcCtsZ0ZGZzNpcW5BaVFhRDBnUzZQTk1EZTlxWHdaemVLYndLa1IK",
      "endpoints": [
        "https://github.com/ValentinSK0/backup-sync/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
